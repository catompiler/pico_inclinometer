{
    "configurations": [
        {
            "name": "Pico",
            "includePath": [
                "${workspaceFolder}/**",
                "${userHome}/.pico-sdk/sdk/2.1.1/**"
            ],
            "forcedInclude": [
                "${userHome}/.pico-sdk/sdk/2.1.1/src/common/pico_base_headers/include/pico.h",
                "${workspaceFolder}/build/generated/pico_base/pico/config_autogen.h"
            ],
            "defines": [
                "DRAW_TO_FULL_BUFFER=1",
                "USE_GRAPHICS_VIRTUAL_BUFFER",
                "USE_GRAPHICS_FORMAT_RGB_565",
                "USE_GRAPHICS_FORMAT_BW_1_V",
                "USE_GRAPHICS_FORMAT_BW_1_H"
            ],
            "compilerPath": "${userHome}/.pico-sdk/toolchain/14_2_Rel1/bin/arm-none-eabi-gcc",
            "compileCommands": "${workspaceFolder}/build/compile_commands.json",
            "cStandard": "c17",
            "cppStandard": "c++14",
            "intelliSenseMode": "linux-gcc-arm"
        }
    ],
    "version": 4
}
